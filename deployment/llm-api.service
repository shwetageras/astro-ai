[Unit]
Description=LLM API Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/astro-ai
Environment="PATH=/home/ubuntu/astro-ai/venv/bin"
ExecStart=/home/ubuntu/astro-ai/venv/bin/python -m uvicorn llm_api:app --host 0.0.0.0 --port 8005
Restart=always

[Install]
WantedBy=multi-user.target