[Unit]
Description=API Chat Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/astro-ai
EnvironmentFile=/home/ubuntu/astro-ai/.env
ExecStart=/home/ubuntu/astro-ai/venv/bin/python -m uvicorn api_chat:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target